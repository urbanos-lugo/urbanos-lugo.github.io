{
  "name": "urbanos-lugo",
  "description": "Liñas, paradas e tempos de paso do autobús urbano de Lugo. Horarios oficiais e estimacións, sempre etiquetados.",
  "version": "1.6.0",
  "license": "MIT",
  "author": "Urbanos de Lugo contributors",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "data:fetch": "tsx tools/importOfficialData.ts",
    "data:osm": "tsx tools/importOsmRoutes.ts",
    "data:walk": "tsx tools/importWalkNetwork.ts",
    "data:elevation": "tsx tools/importElevation.ts",
    "data:walkgraph": "tsx tools/buildWalkGraph.ts",
    "data:build": "tsx tools/buildDataset.ts",
    "map:style": "tsx tools/buildMapStyle.ts",
    "data:audit": "tsx tools/fullAudit.ts",
    "check:landmarks": "tsx tools/checkLandmarks.ts",
    "reconcile": "tsx tools/reconcile.ts",
    "reconcile:selftest": "tsx tools/reconcileSelfTest.ts",
    "test": "tsx tools/test.ts",
    "check:deep": "tsx tools/stressInvariants.ts && tsx tools/stressPlanner.ts",
    "check:parsers": "tsx tools/checkParsersUnchanged.ts",
    "check:policy": "tsx tools/checkPolicy.ts",
    "measure:engine": "tsx tools/stressEngine.ts",
    "measure:parsers": "tsx tools/stressParsers.ts",
    "stress:http": "tsx tools/stressHttp.ts",
    "stress:network": "tsx tools/stressNetwork.ts",
    "compare:operator": "tsx tools/compareOperatorTimes.ts",
    "compare:walk": "tsx tools/compareWalkRouter.ts",
    "data:amenities": "tsx tools/importStopAmenities.ts",
    "data:alerts": "tsx tools/fetchAlerts.ts",
    "diagrams": "tsx tools/buildDiagrams.ts",
    "calibrate:walking": "tsx tools/calibrateWalking.ts",
    "validate:times": "tsx tools/validateRideTimes.ts",
    "worker:build": "esbuild worker/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=worker/dist/worker.js",
    "fonts:import": "tsx tools/importFonts.ts",
    "measure:browser": "tsx tools/stressBrowser.ts",
    "audit:browser": "tsx tools/auditBrowser.ts",
    "audit:journeys": "tsx tools/journeys.ts",
    "visual:shoot": "tsx tools/visualDiff.ts shoot",
    "visual:compare": "tsx tools/visualDiff.ts compare"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
